// GovCMS Database Schema Definition
// PostgreSQL Database Provider with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleEnum {
  SUPER_ADMIN
  ADMINISTRATOR
  EDITOR
  PUBLISHER
}

enum ContentStatusEnum {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentTypeEnum {
  PAGE_DOCUMENT
  PRESS_RELEASE
  PUBLIC_NOTICE
  EVENT
}

enum MenuLocationEnum {
  HEADER_MENU
  FOOTER_MENU
  SIDEBAR_MENU
}

model Agency {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique // e.g. "DOH", "DICT", "DOT"
  slug         String        @unique
  logoUrl      String?
  contactEmail String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  contentItems ContentItem[]
  mediaFolders    MediaFolder[]
  mediaAssets     MediaAsset[]
  menus           Menu[]
  homepageConfigs HomepageConfig[]
  pageBlocks      PageBlockConfig[]
  themeConfigs    ThemeConfig[]

  @@map("agencies")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                RoleEnum             @default(EDITOR)
  isActive            Boolean              @default(true)
  failedLoginAttempts Int                  @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  agencyId            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  agency              Agency?              @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  contents            ContentItem[]        @relation("UserContentAuthor")
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdFolders      MediaFolder[]        @relation("FolderCreator")
  uploadedAssets      MediaAsset[]         @relation("AssetUploader")
  createdMenus        Menu[]               @relation("MenuCreator")
  homepageConfigs     HomepageConfig[]     @relation("HomepageAuthor")
  pageBlocks          PageBlockConfig[]    @relation("PageBlockAuthor")
  themeConfigs        ThemeConfig[]        @relation("ThemeAuthor")

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  isRevoked  Boolean  @default(false)
  rememberMe Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model ContentItem {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  summary       String?
  body          String
  type          ContentTypeEnum   @default(PRESS_RELEASE)
  status        ContentStatusEnum @default(DRAFT)
  featuredImage String?
  eventDate     DateTime?
  location      String?
  isDeleted     Boolean           @default(false)
  deletedAt     DateTime?
  publishedAt   DateTime?
  authorId      String
  agencyId      String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  author        User              @relation("UserContentAuthor", fields: [authorId], references: [id])
  agency        Agency            @relation(fields: [agencyId], references: [id])

  @@map("content_items")
}

model MediaFolder {
  id          String        @id @default(uuid())
  name        String
  slug        String
  parentId    String?
  agencyId    String
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent      MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    MediaFolder[] @relation("FolderHierarchy")
  agency      Agency        @relation(fields: [agencyId], references: [id])
  createdBy   User          @relation("FolderCreator", fields: [createdById], references: [id])
  assets      MediaAsset[]

  @@unique([agencyId, parentId, slug])
  @@map("media_folders")
}

model MediaAsset {
  id           String       @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  dimensions   String?      // e.g. "1920x1080"
  altText      String?
  caption      String?
  isOptimized  Boolean      @default(true)
  folderId     String?
  agencyId     String
  uploadedById String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  agency       Agency       @relation(fields: [agencyId], references: [id])
  uploadedBy   User         @relation("AssetUploader", fields: [uploadedById], references: [id])

  @@map("media_assets")
}

model Menu {
  id          String           @id @default(uuid())
  name        String
  code        String           @unique
  location    MenuLocationEnum @default(HEADER_MENU)
  agencyId    String
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  agency      Agency           @relation(fields: [agencyId], references: [id])
  createdBy   User             @relation("MenuCreator", fields: [createdById], references: [id])
  items       MenuItem[]

  @@map("menus")
}

model MenuItem {
  id           String     @id @default(uuid())
  menuId       String
  parentId     String?
  title        String
  url          String
  icon         String?
  isExternal   Boolean    @default(false)
  openInNewTab Boolean    @default(false)
  isVisible    Boolean    @default(true)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       MenuItem?  @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuItemHierarchy")

  @@map("menu_items")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "LOGIN", "CREATE_CONTENT", "CREATE_MENU", "REORDER_MENU"
  entityType String   // e.g. "ContentItem", "Menu", "MenuItem", "User"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model HomepageConfig {
  id          String   @id @default(uuid())
  name        String   @default("Default Homepage")
  slug        String   @unique @default("homepage")
  sections    Json     // Array of section objects with type, order, visibility, config
  isDraft     Boolean  @default(true)
  publishedAt DateTime?
  agencyId    String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency      Agency   @relation(fields: [agencyId], references: [id])
  author      User     @relation("HomepageAuthor", fields: [authorId], references: [id])

  @@map("homepage_configs")
}

model PageBlockConfig {
  id          String   @id @default(uuid())
  title       String   @default("Untitled Page")
  slug        String   @unique
  blocks      Json     // Array of block objects with type, order, config, collapsed state
  isDraft     Boolean  @default(true)
  publishedAt DateTime?
  agencyId    String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency      Agency   @relation(fields: [agencyId], references: [id])
  author      User     @relation("PageBlockAuthor", fields: [authorId], references: [id])

  @@map("page_block_configs")
}

model ThemeConfig {
  id              String   @id @default(uuid())
  websiteName     String   @default("GovCMS Agency Portal")
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#1d4ed8")
  secondaryColor  String   @default("#7c3aed")
  fontHeading     String   @default("Inter")
  fontBody        String   @default("Inter")
  navbarStyle     Json?    // {bgColor, textColor, position, height}
  footerStyle     Json?    // {bgColor, textColor, showSocials, copyright}
  buttonStyle     Json?    // {borderRadius, fontWeight, textTransform}
  darkModeEnabled Boolean  @default(false)
  customCss       String?  @db.Text
  isActive        Boolean  @default(true)
  publishedAt     DateTime?
  agencyId        String
  authorId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agency          Agency   @relation(fields: [agencyId], references: [id])
  author          User     @relation("ThemeAuthor", fields: [authorId], references: [id])

  @@map("theme_configs")
}
